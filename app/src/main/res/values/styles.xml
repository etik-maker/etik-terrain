<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#1F4E79</item>
        <item name="android:colorAccent">#E8A33D</item>
        <item name="android:statusBarColor">#1F4E79</item>
    </style>
    <style name="MapButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">#1F4E79</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">3dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>
</resources>
